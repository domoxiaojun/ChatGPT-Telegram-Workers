#COHERE_MODELS_API = '/models'

# ============================================================
# 20 Fish Audio 配置
# ============================================================

# Fish API Key，多个 key 用逗号分隔。
# 仅 AI_TTS_PROVIDER=fish 时使用。
#FISH_API_KEY = ''

# Fish API Base。
#FISH_API_BASE = 'https://api.fish.audio/v1'

# Fish voice/reference id；不填时使用模型默认。
# 可填 Fish 声音 id，也可使用 FISH_REFERENCE_IDS 中映射的名称。
#FISH_TTS_VOICE = ''

# Fish TTS 模型。
#FISH_TTS_MODEL = 'speech-1.6'

# Fish TTS 额外参数。
#FISH_TTS_EXTRA_PARAMS = '{}'

# Fish 内置 reference id 映射；JSON 对象，会与内置默认值合并。
#FISH_REFERENCE_IDS = '{"丁真":"54a5170264694bfc8e9ad98df7bd89c3"}'

# ============================================================
# 21 Black Forest Labs 配置
# ============================================================

# Black Forest Labs API Key，多个 key 用逗号分隔。
# 仅 AI_IMAGE_PROVIDER=bfl 或 image_gen agent=bfl 时使用。
#BFL_API_KEY = ''

# Black Forest Labs API Base。
#BFL_API_BASE = 'https://api.bfl.ai/v1'

# BFL 图片模型；常用 flux-2-pro,flux-2-max,flux-2-flex,flux-2-klein-4b,flux-2-klein-9b,flux-kontext-pro,flux-kontext-max,flux-pro-1.1-ultra,flux-pro-1.0-fill。
#BFL_IMAGE_MODEL = 'flux-2-klein-9b'

# ============================================================
# 22 KlingAI 图片配置
# ============================================================

# KlingAI Cookie，多个 cookie 用逗号分隔。
# 仅 AI_IMAGE_PROVIDER=kling 或 /kling 命令使用；Cookie 失效后需要重新获取。
#KLINGAI_COOKIE = ''

# KlingAI 生成图片数量。
# 实际上限由 Kling 页面/API 决定；数量越多越慢。
#KLINGAI_IMAGE_COUNT = '1'

# KlingAI 图片比例。
# 常见 1:1、16:9、9:16；具体支持取决于 Kling 接口。
#KLINGAI_IMAGE_RATIO = '1:1'

# ============================================================
# 23 模型参数、别名、输出与工作流
# ============================================================

# /set 命令短参数映射。
# 左侧是命令短参数，右侧是实际配置键；改错会导致 /set 无法找到键。
# CHAT_MODEL / IMAGE_MODEL / VISION_MODEL 是快捷入口，不建议写进 wrangler 作为全局环境变量；
# 在 /set、/setenv、/setenvs、后台 admin 中使用时会按当前 provider 自动解析到真实模型变量。
#MAPPING_KEY = '-p:SYSTEM_INIT_MESSAGE|-n:MAX_HISTORY_LENGTH|-a:AI_CHAT_PROVIDER|-ai:AI_IMAGE_PROVIDER|-m:CHAT_MODEL|-v:VISION_MODEL|-t:OPENAI_TTS_MODEL|-ex:OPENAI_API_EXTRA_PARAMS|-mk:MAPPING_KEY|-mv:MAPPING_VALUE|-tm:TOOL_MODEL|-tool:USE_TOOLS|-im:IMAGE_MODEL|-th:TEXT_HANDLE_TYPE|-to:TEXT_OUTPUT|-ah:AUDIO_HANDLE_TYPE|-ao:AUDIO_OUTPUT|-act:AUDIO_CONTAINS_TEXT|-as:AI_ASR_PROVIDER|-at:AI_TTS_PROVIDER|-ra:RERANK_AGENT|-ew:ENABLE_WORKFLOW|-tp:CHAT_TEMPERATURE'

# 模型/常用值别名映射；例如 g55:gpt-5.5|g4m:gpt-4o-mini。
# 配合 ENABLE_ALIAS 和 /set 使用，方便在 Telegram 中输入短别名。
#MAPPING_VALUE = ''

# 是否启用 MAPPING_VALUE 里的模型别名。
#ENABLE_ALIAS = 'false'

# 是否显示模型、耗时、token、工具等信息。
#ENABLE_SHOWINFO = 'false'

# 显示哪些信息：model,model_time,token,tool,tool_time,first_chunk_time。
# ENABLE_SHOWINFO=true 时才会展示；tool/tool_time 需要工具调用实际发生。
#SHOW_PARTS = 'model,model_time,token,tool,tool_time'

# 提示词模板覆盖，JSON 对象；会与内置 PROMPT 合并。
#PROMPT = '{}'

# 聊天温度；空表示 SDK/模型默认。
# 推理模型或部分新模型可能不支持 temperature；必要时用 PARAMS_MODIFIER 删除。
#CHAT_TEMPERATURE = ''

# 工具调用温度；空表示 SDK/模型默认。
# 只影响工具选择/工具模型阶段；大多数场景保持空即可。
#FUNCTION_CALL_TEMPERATURE = ''

# 最大输出 token；空表示 SDK/模型默认。
#MAX_TOKENS = ''

# 单次生成最大步骤数，工具调用/续写会消耗步骤。
# web_search、image_gen、repo reader 等自动工具调用都可能占用 step；工具多时可提高到 8-12。
#MAX_STEPS = '5'

# 单次生成失败最大重试次数。
#MAX_RETRIES = '0'

# 是否启用 continue steps 生成长文本。
#CONTINUE_STEP = 'false'

# Rerank provider：jina,openai,oailikeV1,oailikeV2,google。
# 影响检索/网页等场景排序；没有相关功能时可保持默认。
#RERANK_AGENT = 'google'

# Jina rerank 模型。
#JINA_RERANK_MODEL = 'jina-colbert-v2'

# 是否启用智能模型匹配。
# 会尝试从 provider 模型列表中选择模型；依赖 *_MODELS 或 *_MODELS_API，可增加复杂度。
#ENABLE_INTELLIGENT_MODEL = 'false'

# 文本输入处理方式：text 走普通聊天，tts 转语音，chat 走音频预览聊天。
#TEXT_HANDLE_TYPE = 'text'

# 文本回复输出方式：text / audio。
#TEXT_OUTPUT = 'text'

# 音频输入处理方式：stt 转文字，audio 传音频，chat 走音频预览聊天。
#AUDIO_HANDLE_TYPE = 'stt'

# 音频回复输出方式：text / audio。
#AUDIO_OUTPUT = 'text'

# 发送语音时是否附带文本。
#AUDIO_CONTAINS_TEXT = 'true'

# 音频理解默认提示词。
#AUDIO_PROMPT = 'Please listen to the audio file. Identify and understand the question being asked in the audio. Then, provide a detailed explanation and answer to this question. Ensure your answer is helpful and explains the solution or information clearly.'

# 覆盖消息 role，例如 {"o1-mini,o1-preview":"system:user"}。
#COVER_MESSAGE_ROLE = '{}'

# 消息文本替换表，JSON 对象。
#MESSAGE_REPLACER = '{}'

# 参数修改器；格式 model1,model2:-temperature|+max_tokens=1000。
# 用于按模型前缀增删请求参数，适合适配不同网关/模型限制。
#PARAMS_MODIFIER = 'o1-mini,o3-mini,gpt-4o-mini-search-preview,gpt-4o-search-preview:-temperature'

# 是否启用智能上下文压缩。
#ENABLE_CONTEXT_COMPRESSION = 'true'

# 上下文压缩触发阈值，0-1；例如 0.60 表示达到上下文窗口 60% 时压缩。
#CONTEXT_COMPRESSION_THRESHOLD = '0.60'

# 压缩时保护开头消息数量。
#CONTEXT_COMPRESSION_PROTECT_HEAD = '3'

# 压缩时保留尾部 token 预算。
#CONTEXT_COMPRESSION_TAIL_BUDGET = '15000'

# 摘要目标比例，0-1。
#CONTEXT_COMPRESSION_SUMMARY_RATIO = '0.20'

# 工作流配置；@key 触发，{{result}} 是上一步结果，{{question}} 是用户原始输入。
#WORKFLOW = '{"think":[{"agent":"oailike","model":"deepseek-reasoner","temperature":0.3,"max_tokens":1024,"next":"思考内容: {{result}}\n\n基于以上思考回答问题: {{question}}"}]}'

# 是否启用 WORKFLOW。
#ENABLE_WORKFLOW = 'false'
