# 16 Anthropic 配置
# ============================================================

# Anthropic API Key，多个 key 用逗号分隔。
# 仅 AI_CHAT_PROVIDER=anthropic 时使用。
#ANTHROPIC_API_KEY = ''

# Anthropic API Base。
#ANTHROPIC_API_BASE = 'https://api.anthropic.com/v1'

# Anthropic 聊天模型。
#ANTHROPIC_CHAT_MODEL = 'claude-3-5-haiku-20241022'

# Anthropic 视觉模型。
#ANTHROPIC_VISION_MODEL = 'claude-3-5-haiku-20241022'

# Anthropic 额外参数，按模型前缀匹配。
# 可配置 thinking、temperature 等 Anthropic 原生参数；示例为 Claude 3.7 thinking。
#ANTHROPIC_API_EXTRA_PARAMS = '{"claude-3-7-sonnet":{"temperature":1,"thinking":{"type":"enabled","budget_tokens":4096}}}'

# 手动维护的 Anthropic 模型列表。
#ANTHROPIC_MODELS = ''

# Anthropic 模型列表 API。
#ANTHROPIC_MODELS_API = '/models'

# 是否启用 Anthropic prompt cache。
# true 会尽量缓存 system/tools，降低重复对话成本；上游不支持时可能无效。
#ANTHROPIC_ENABLE_CACHE_CONTROL = 'true'

# 启用 Anthropic web fetch。
# 抓取指定网页内容，适合用户给 URL 后读取页面；需要模型/账号支持。
#ANTHROPIC_ENABLE_WEB_FETCH = 'false'

# web fetch 最大调用次数。
#ANTHROPIC_WEB_FETCH_MAX_USES = '5'

# web fetch 允许域名；空表示不限制。
#ANTHROPIC_WEB_FETCH_ALLOWED_DOMAINS = ''

# web fetch 禁止域名；空表示不排除。
#ANTHROPIC_WEB_FETCH_BLOCKED_DOMAINS = ''

# web fetch 是否启用 citations。
#ANTHROPIC_WEB_FETCH_ENABLE_CITATIONS = 'true'

# web fetch 最大内容 tokens。
#ANTHROPIC_WEB_FETCH_MAX_CONTENT_TOKENS = '4000'

# 启用 Anthropic web search。
# 搜索网页，不需要写入 USE_TOOLS；需要模型/账号支持。
#ANTHROPIC_ENABLE_WEB_SEARCH = 'false'

# web search 最大调用次数。
#ANTHROPIC_WEB_SEARCH_MAX_USES = '5'

# web search 允许域名；空表示不限制。
#ANTHROPIC_WEB_SEARCH_ALLOWED_DOMAINS = ''

# web search 禁止域名；空表示不排除。
#ANTHROPIC_WEB_SEARCH_BLOCKED_DOMAINS = ''

# web search 用户位置；空表示不传位置。
#ANTHROPIC_WEB_SEARCH_USER_LOCATION = ''

# 启用 Anthropic code execution。
# Anthropic server-side 代码执行；不是在你的 Linux 服务器本地执行。
#ANTHROPIC_ENABLE_CODE_EXECUTION = 'false'

# 是否启用细粒度工具流。
# true 可以更早显示工具调用进度；若上游/SDK 不稳定可改 false。
#ANTHROPIC_ENABLE_TOOL_STREAMING = 'true'

# 是否启用 Anthropic context management，自动清理历史工具调用。
# true 可降低长对话工具历史导致的上下文膨胀；排查历史问题时可临时关闭。
#ANTHROPIC_ENABLE_CONTEXT_MANAGEMENT = 'true'

# context management 触发模式：auto / manual。
#ANTHROPIC_CONTEXT_CLEAR_TRIGGER = 'auto'

# 保留最近 N 次工具调用。
#ANTHROPIC_CONTEXT_KEEP_RECENT = '5'

# 至少清理 N 千 tokens。
#ANTHROPIC_CONTEXT_CLEAR_AT_LEAST = '2'

# 是否清理工具输入参数。
#ANTHROPIC_CONTEXT_CLEAR_TOOL_INPUTS = 'false'

# context management 排除工具列表。
#ANTHROPIC_CONTEXT_EXCLUDE_TOOLS = ''

# 是否清理 thinking 内容。
#ANTHROPIC_ENABLE_THINKING_CLEANUP = 'false'

# 保留最近 N 轮 thinking。
#ANTHROPIC_THINKING_KEEP_RECENT = '3'

# 结构化输出模式：outputFormat / tool / auto。
# auto 让 SDK 自动选择；强 JSON/结构化任务可按模型能力调整。
#ANTHROPIC_STRUCTURED_OUTPUT_MODE = 'auto'

# Anthropic providerOptions。
#ANTHROPIC_PROVIDER_OPTIONS = '{}'

# ============================================================
# 17 xAI / Grok 配置
# ============================================================

# xAI API Key，多个 key 用逗号分隔。
# 仅 AI_CHAT_PROVIDER/AI_IMAGE_PROVIDER=xai 时使用。
#XAI_API_KEY = ''

# xAI API Base。
#XAI_API_BASE = 'https://api.x.ai/v1'

# xAI 聊天模型。
# 仅 AI_CHAT_PROVIDER=xai 时使用；Responses 工具建议搭配 XAI_RESPONSE_MODELS。
#XAI_CHAT_MODEL = 'grok-4-1-fast'

# xAI 视觉模型。
#XAI_VISION_MODEL = 'grok-2-vision'

# xAI 图片模型。
#XAI_IMAGE_MODEL = 'grok-imagine-image'

# xAI 额外参数，按模型前缀匹配。
#XAI_API_EXTRA_PARAMS = '{}'

# 手动维护的 xAI 模型列表。
#XAI_MODELS = ''

# xAI 模型列表 API。
#XAI_MODELS_API = '/models'

# xAI providerOptions，例如 {"reasoningEffort":"high"}。
# 透传给 xAI SDK provider；支持项取决于当前 @ai-sdk/xai 版本和上游模型。
#XAI_PROVIDER_OPTIONS = '{}'

# 使用 xAI Responses API 的模型列表；'*' 表示全部。
# xAI 新工具能力一般走 Responses；如遇兼容问题可缩小到指定模型前缀。
#XAI_RESPONSE_MODELS = '*'

# 是否允许 xAI 服务端存储对话。
# false 会尽量关闭服务端会话存储，隐私更好；但某些连续能力可能受影响。
#XAI_STORE_CONVERSATION = 'true'

# 启用 xAI web search。
# 域名过滤为空也能正常搜索全网；只有设置 allowed/excluded 时才限制来源。
#XAI_ENABLE_WEB_SEARCH = 'false'

# 启用 X/Twitter search。
# 搜索 X/Twitter 内容；handles 过滤为空表示不限制账号。
#XAI_ENABLE_X_SEARCH = 'false'

# 启用 xAI code execution。
#XAI_ENABLE_CODE_EXECUTION = 'false'

# 启用 xAI file search。
#XAI_ENABLE_FILE_SEARCH = 'false'

# xAI file search vector store / collection id 列表。
#XAI_FILE_SEARCH_VECTOR_STORES = ''

# xAI file search 最大结果数。
#XAI_FILE_SEARCH_MAX_RESULTS = '10'

# xAI web search 允许域名，最多 5 个；空表示不限制，仍可正常搜索全网。
#XAI_WEB_SEARCH_ALLOWED_DOMAINS = ''

# xAI web search 排除域名，最多 5 个；空表示不排除。
#XAI_WEB_SEARCH_EXCLUDED_DOMAINS = ''

# xAI web search 是否理解结果中的图片。
#XAI_WEB_SEARCH_IMAGE_UNDERSTANDING = 'false'

# xAI X search 允许 handles，最多 10 个；空表示不限制。
#XAI_X_SEARCH_ALLOWED_HANDLES = ''

# xAI X search 排除 handles，最多 10 个；空表示不排除。
#XAI_X_SEARCH_EXCLUDED_HANDLES = ''

# xAI X search 是否理解图片。
#XAI_X_SEARCH_IMAGE_UNDERSTANDING = 'false'

# xAI X search 是否理解视频。
#XAI_X_SEARCH_VIDEO_UNDERSTANDING = 'false'

# ============================================================
# 18 Mistral 配置
# ============================================================

# Mistral API Key，多个 key 用逗号分隔。
# 仅 AI_CHAT_PROVIDER=mistral 时使用。
#MISTRAL_API_KEY = ''

# Mistral API Base。
#MISTRAL_API_BASE = 'https://api.mistral.ai/v1'

# Mistral 聊天模型。
#MISTRAL_CHAT_MODEL = 'mistral-tiny'

# 手动维护的 Mistral 模型列表。
#MISTRAL_MODELS = ''

# Mistral 模型列表 API。
#MISTRAL_MODELS_API = '/models'

