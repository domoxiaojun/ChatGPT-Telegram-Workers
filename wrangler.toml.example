# ============================================================
# 14 Google Gemini / AI Studio 配置
# ============================================================

# Google API Key，多个 key 用逗号分隔。
# 仅 AI_CHAT_PROVIDER/AI_IMAGE_PROVIDER/AI_TTS_PROVIDER 选择 google，或使用 Google 工具时需要。
#GOOGLE_API_KEY = ''

# Google Gemini API Base；不要以 /models 结尾。
#GOOGLE_API_BASE = 'https://generativelanguage.googleapis.com/v1beta'

# Gemini 聊天模型。
# 仅 AI_CHAT_PROVIDER=google 时使用；模型名要匹配 GOOGLE_API_BASE 暴露版本。
#GOOGLE_CHAT_MODEL = 'gemini-2.5-flash'

# Gemini 视觉模型。
# 处理图片理解时使用；不是图片生成模型。
#GOOGLE_VISION_MODEL = 'gemini-2.5-flash'

# Gemini 图片模型。
# 仅 AI_IMAGE_PROVIDER=google 或 image_gen agent=google 时使用。
#GOOGLE_IMAGE_MODEL = 'gemini-3.1-flash-image-preview'

# Google embedding 模型。
#GOOGLE_EMBEDDING_MODEL = 'text-embedding-004'

# Google 额外请求参数，按模型前缀匹配；支持 generationConfig.thinkingConfig 等路径。
#GOOGLE_API_EXTRA_PARAMS = '{}'

# 手动维护的 Google 模型列表。
#GOOGLE_MODELS = ''

# Google 模型列表 API 路径。
#GOOGLE_MODELS_API = '/models'

# 启用 Google Search grounding。
# 这是 Google/Gemini 原生工具，不是项目 duckduckgo，也不需要写入 USE_TOOLS。
#GOOGLE_ENABLE_GOOGLE_SEARCH = 'false'

# 启用 Google Code Execution。
# 由 Google/Gemini server-side 执行，不是本项目本地执行代码。
#GOOGLE_ENABLE_CODE_EXECUTION = 'false'

# 启用 Google URL Context。
# 让 Gemini 读取 URL 上下文；不等同项目工具 browser_navigate。
#GOOGLE_ENABLE_URL_CONTEXT = 'false'

# 启用 Google Maps grounding。
# 适合地点、路线、商家等地图相关问题；模型不支持时会自动跳过或切换 GOOGLE_MAPS_MODEL。
#GOOGLE_ENABLE_GOOGLE_MAPS = 'false'

# 启用 Google File Search。
# 需要先配置 GOOGLE_FILE_SEARCH_STORES，否则不会实际挂载文件搜索。
#GOOGLE_ENABLE_FILE_SEARCH = 'false'

# 启用 Google Enterprise Web Search。
# 需要账号/模型/接口支持；普通 Gemini 账号不一定可用。
#GOOGLE_ENABLE_ENTERPRISE_WEB_SEARCH = 'false'

# googleSearch 中是否启用网页搜索。
# 只有 GOOGLE_ENABLE_GOOGLE_SEARCH=true 时才有意义。
#GOOGLE_SEARCH_ENABLE_WEB_SEARCH = 'true'

# googleSearch 中是否启用图片搜索。
# 开启后 grounding 可能包含图片结果；并非图片生成。
#GOOGLE_SEARCH_ENABLE_IMAGE_SEARCH = 'false'

# Google 搜索时间范围过滤，ISO 8601 时间。
# 例如 {"startTime":"2026-01-01T00:00:00Z","endTime":"2026-12-31T23:59:59Z"}；空对象表示不过滤。
#GOOGLE_SEARCH_TIME_RANGE_FILTER = '{}'

# Google File Search store 列表。
# 只有 GOOGLE_ENABLE_FILE_SEARCH=true 时生效；空表示不挂载 store。
#GOOGLE_FILE_SEARCH_STORES = ''

# Google File Search topK。
#GOOGLE_FILE_SEARCH_TOP_K = '10'

# Google File Search metadata filter。
# JSON 或过滤表达式由 Google SDK/接口决定；空表示不过滤 metadata。
#GOOGLE_FILE_SEARCH_METADATA_FILTER = ''

# Google Maps grounding 位置上下文，例如 {"latLng":{"latitude":31.2,"longitude":121.5}}。
#GOOGLE_RETRIEVAL_CONFIG = '{}'

# 启用 googleMaps 时自动切换的模型；空字符串表示不自动切换。
#GOOGLE_MAPS_MODEL = 'gemini-3-flash-preview'

# Google TTS 模型。
#GOOGLE_TTS_MODEL = 'gemini-2.5-flash-preview-tts'

# Gemini 图片比例：1:1,2:3,3:2,3:4,4:3,4:5,5:4,9:16,16:9,21:9,1:8,8:1,1:4,4:1。
# 空表示交给模型/SDK 默认；只有 AI_IMAGE_PROVIDER=google 时使用。
#GOOGLE_IMAGE_ASPECT_RATIO = ''

# Gemini 图片分辨率：1K,2K,4K,512。
# 空表示默认；高分辨率更慢、成本更高，并且要看模型是否支持。
#GOOGLE_IMAGE_SIZE = ''

# Gemini 图片生成是否启用 Google Search grounding。
# 适合需要参考真实世界信息的生图；会增加联网依赖和延迟。
#GOOGLE_IMAGE_ENABLE_GOOGLE_SEARCH = 'false'

# Google TTS voice。
#GOOGLE_TTS_VOICE = 'Zephyr'

# Google TTS prompt。
#GOOGLE_TTS_PROMPT = ''

# Google TTS 额外参数；若配置 multi_speaker_voice_config，通常不要同时用 GOOGLE_TTS_VOICE。
#GOOGLE_TTS_EXTRA_PARAMS = '{}'

# Google providerOptions；默认关闭各类 safety block。
# 可放 thinkingConfig、responseModalities、structuredOutputs 等 SDK 支持项。
#GOOGLE_PROVIDER_OPTIONS = '{"safetySettings":[{"category":"HARM_CATEGORY_DANGEROUS_CONTENT","threshold":"BLOCK_NONE"},{"category":"HARM_CATEGORY_HARASSMENT","threshold":"BLOCK_NONE"},{"category":"HARM_CATEGORY_HATE_SPEECH","threshold":"BLOCK_NONE"},{"category":"HARM_CATEGORY_SEXUALLY_EXPLICIT","threshold":"BLOCK_NONE"},{"category":"HARM_CATEGORY_CIVIC_INTEGRITY","threshold":"BLOCK_NONE"}],"threshold":"OFF"}'

