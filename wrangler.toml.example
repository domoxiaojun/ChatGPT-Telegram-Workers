# Cohere API Key，多个 key 用逗号分隔。
# 仅 AI_CHAT_PROVIDER=cohere 或 RERANK_AGENT 选择 cohere 相关能力时使用。
#COHERE_API_KEY = ''

# Cohere API Base。
#COHERE_API_BASE = 'https://api.cohere.com/v1'

# Cohere 聊天模型。
#COHERE_CHAT_MODEL = 'command-r-plus'

