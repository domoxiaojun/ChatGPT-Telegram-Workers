{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "ESNext",
            "dom",
            "dom.iterable"
        ],
        "useDefineForClassFields": true,
        "emitDecoratorMetadata": false,
        "rootDir": ".",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "allowJs": true,
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "dist",
        "removeComments": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts"
    ]
}
